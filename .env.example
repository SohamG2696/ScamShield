# ============================================================
# ScamShield Environment Configuration Template
# Copy this file to .env and fill in your actual credentials:
#   Copy-Item .env.example .env
# ============================================================

# ------------------------------------------------------------
# Backend Configuration (FastAPI & ML Services)
# ------------------------------------------------------------

# Groq API Key for AI fraud intelligence and deep report generation
# Obtain key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (defaults to openai/gpt-oss-120b; fallback to openai/gpt-oss-20b, qwen/qwen3.8-27b)
GROQ_MODEL=openai/gpt-oss-120b

# Supabase (Optional for persistent prediction logging)
# Obtain at: Supabase Console -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Allowed CORS Origins (comma-separated; defaults to Azure Static Web Apps and localhost)
ALLOWED_ORIGINS=https://happy-cliff-00cb7b800.4.azurestaticapps.net,http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------
# Frontend Configuration (React / Vite)
# ------------------------------------------------------------

# FastAPI Backend URL accessed by the browser
# In local Docker Desktop, the browser reaches the backend via localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# Google OAuth 2.0 Client ID (Required for Gmail Scan & Google Sign-In)
# Obtain at: https://console.cloud.google.com/apis/credentials
# IMPORTANT FOR DOCKER: Add "http://localhost:3000" and "http://localhost:5173" to Authorized JavaScript Origins
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
