# Base URL of your FastAPI backend (accessed by browser, no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# Google OAuth 2.0 Client ID (from Google Cloud Console)
# Required for Gmail integration and Google Sign-In
# See: https://console.cloud.google.com/apis/credentials
# In Docker, ensure "http://localhost:3000" is added to Authorized JavaScript Origins
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
