# ============================================================
# ScamShield — Git Ignore Configuration
# ============================================================

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
.venv/
.venv*/
venv/
ENV/
env/

# --- Environment Secrets & Credentials ---
# Never commit real API keys or credentials to version control!
.env
.env.*
!.env.example
*.local

# --- Frontend (Node / Vite / React) ---
node_modules/
dist/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.vite/

# --- Temporary Uploads & Storage ---
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
*.log
tmp/

# --- Testing & Code Quality ---
.pytest_cache/
.coverage
.coverage.*
coverage/
.cache
nosetests.xml
coverage.xml

# --- IDE & Operating System Artifacts ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- Archives ---
*.zip
*.tar.gz
*.rar
*.7z

